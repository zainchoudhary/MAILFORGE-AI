DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
REDIS_URL=
JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
CORS_ORIGINS=http://localhost:5173
PUBLIC_URL=http://localhost:5173
STORAGE_PATH=.local/uploads
DRY_RUN=true
DELAY_BETWEEN_EMAILS=2
MAX_RETRIES=2
MAX_ATTACHMENT_BYTES=18000000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_TIMEOUT=30
# Official Outreach Studio sender for password resets and system emails only (never used for campaigns).
SYSTEM_MAIL_HOST=smtp.gmail.com
SYSTEM_MAIL_PORT=587
SYSTEM_MAIL_SECURITY=starttls
SYSTEM_MAIL_USERNAME=official@outreachstudio.com
SYSTEM_MAIL_PASSWORD=MAILBOX_APP_PASSWORD
SYSTEM_MAIL_FROM="Outreach Studio <official@outreachstudio.com>"
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CLAMAV_HOST=
REQUIRE_MALWARE_SCAN=false
ALLOW_PRIVATE_SMTP=false
PROVIDER_WEBHOOK_SECRET=
LEAD_SEARCH_PROVIDER=serper
SERPER_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
LEAD_FINDER_MAX_PER_RUN=100
LEAD_FINDER_FIRST_BATCH=20
