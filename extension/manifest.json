{
  "manifest_version": 3,
  "name": "Outreach Studio — LinkedIn Capture",
  "version": "0.5.0",
  "description": "Search LinkedIn posts by keyword, auto-scroll, and sync public emails to Outreach Studio",
  "permissions": ["storage", "sidePanel", "activeTab", "scripting", "alarms", "tabs"],
  "icons": {
    "32": "src/assets/favicon-32.png"
  },
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "side_panel": { "default_path": "src/sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["src/content/jobs.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/lib/selectors.js",
        "src/lib/parse.js",
        "src/lib/posts.js",
        "src/lib/detail.js",
        "src/lib/capture.js",
        "src/lib/searchCollect.js"
      ],
      "matches": ["https://www.linkedin.com/*"]
    }
  ],
  "action": { "default_title": "Outreach Studio Capture" }
}
